{
  "name": "rfastack-fulfillment-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun scripts/workspace.ts dev",
    "build": "bun scripts/workspace.ts build",
    "start": "bun scripts/workspace.ts start",
    "typecheck": "bun scripts/workspace.ts typecheck && tsc --noEmit",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:seed": "bun scripts/seed.ts",
    "db:reset": "bun scripts/reset.ts",
    "test": "playwright test",
    "test:unit": "vitest run",
    "carrier": "bun scripts/carrier.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.9",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/bun": "1.3.10",
    "prettier": "3.6.2",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "turbo": "2.10.12",
    "@elysia/eden": "1.4.10",
    "elysia": "1.4.30",
    "@rfastack/http-api": "workspace:*",
    "@rfastack/http-contracts": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
