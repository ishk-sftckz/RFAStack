{
  "name": "rfastack-b2b-ordering",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --bun next dev -p 3103",
    "build": "bun --bun next build",
    "start": "bun --bun next start -p 3103",
    "typecheck": "bun --bun next typegen && tsc --noEmit",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:seed": "bun scripts/seed.ts",
    "db:reset": "bun scripts/reset.ts",
    "test": "playwright test",
    "test:unit": "vitest run",
    "client": "bun scripts/client.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "better-auth": "1.7.3",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "zod": "4.3.6",
    "server-only": "0.0.1",
    "@tanstack/react-query": "5.102.8",
    "@orpc/server": "1.15.0",
    "@orpc/client": "1.15.0",
    "@orpc/tanstack-query": "1.15.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.9",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/bun": "1.3.10",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
